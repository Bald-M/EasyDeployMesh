{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyDeployMesh",
  "version": "0.2.4",
  "identifier": "com.easydeploymesh.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EasyDeployMesh",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 680,
        "backgroundColor": "#020617",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "binaries/easydeploymesh-agent-x86_64-pc-windows-msvc.exe": "easydeploymesh-agent.exe"
    },
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform Windows deployment orchestration",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
